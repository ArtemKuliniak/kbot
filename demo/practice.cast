[201.378444, "o", "\u001b[35m\"sh\"\u001b[31m,\u001b[35m \"-c\"\u001b[31m,\u001b[35m \"while \u001b[0m\u000f\u001b[32mtrue\u001b[0;1m\u000f\u001b[35m; do \u001b[31m{\u001b[35m echo -e HTTP/1.1 200 OK \u001b[0m\u000f\u001b[32m\\n\\n\u001b[0;1m\u000f\u001b[35m Version\u001b[31m:\u001b[35m 1.0.0'; \u001b[31m}\u001b[35m | nc -vlp 8080; done\"\u001b[12;17H\u001b[34m]\u001b[31m,\u001b[13d\b\b\u001b[34m\"env\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[34m[\u001b[14d\u001b[35m\"PATH=/usr/local/sbin\u001b[31m:\u001b[35m/usr/local/bin\u001b[31m:\u001b[35m/usr/sbin\u001b[31m:\u001b[35m/usr/bin\u001b[31m:\u001b[35m/sbin\u001b[31m:\u001b[35m/bin\"\u001b[31m,\u001b[15;25H\u001b[35m\"TERM=xterm\"\u001b[16;17H\u001b[34m]\u001b[31m,\u001b[17d\b\b\u001b[34m\"cwd\"\u001b[31m:\u001b[35m \"/\"\u001b[31m,\u001b[18;17H\u001b[34m\"capabilities\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[31m{\u001b[19;25H\u001b[34m\"bounding\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[34m[\u001b[20;33H\u001b[35m\"CAP_AUDIT_WRITE\"\u001b[31m,\u001b[21;33H\u001b[35m\"CAP_KILL\"\u001b[31m,\u001b[22;33H\u001b[35m\"CAP_NET_BIND_SERVICE\"\u001b[23;25H\u001b[34m]\u001b[31m,\u001b[24d\b\b\u001b[34m\"effective\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[34m[\u001b[25;33H\u001b[35m\"CAP_AUDIT_WRITE\"\u001b[31m,\u001b[26;33H\u001b[35m\"CAP_KILL\"\u001b[31m,\u001b[27;33H\u001b[35m\"CAP_NET_BIND_SERVICE\"\u001b[28;25H\u001b[34m]\u001b[31m,\u001b[29d\b\b\u001b[34m\"permitted\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[34m[\u001b[30;33H\u001b[35m\"CAP_AUDIT_WRITE\"\u001b[31m,\u001b[31;33H\u001b[35m\"CAP_KILL\"\u001b[31m,\u001b[32;33H\u001b[35m\"CAP_NET_BIND_SERVICE\"\u001b[33;25H\u001b[34m]\u001b[34;17H\u001b[31m},\u001b[35d\b\b\u001b[34m\"rlimits\"\u001b[31m:\u001b[39m\u001b[m\u000f \u001b[0;1m\u000f\u001b[34m[\u001b[36;25H\u001b[31m{\u001b[37;33H"]
